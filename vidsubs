#!/usr/bin/env python3
import os
import sys
from guessit import guessit

def is_hebrew_sub(srt_path):
    """Return True if the subtitle file is a Hebrew subtitle."""
    name = os.path.basename(srt_path).lower()
    return (
        name.endswith('.he.srt') or
        name.endswith('.heb.srt') or
        name.endswith('.en-he.srt') or
        '-he.srt' in name or
        '-heb.srt' in name
    )

def match_videos_to_subtitles(folder_path):
    video_files = []
    subtitle_files = []
    video_extensions = ['.mp4', '.avi', '.mkv', '.ts']

    # Collect all video and subtitle files
    for file in os.listdir(folder_path):
        full_path = os.path.join(folder_path, file)
        if any(file.endswith(ext) for ext in video_extensions):
            video_files.append(full_path)
        elif file.endswith('.srt'):
            subtitle_files.append(full_path)

    subtitle_metadata = {}

    # Index only Hebrew subtitles by episode key
    for srt in subtitle_files:
        if not is_hebrew_sub(srt):
            continue
        metadata = guessit(srt)
        season = metadata.get('season')
        episode = metadata.get('episode')
        media_type = metadata.get('type')

        if media_type == "episode":
            if isinstance(episode, list):
                episode_key = "-".join([f"e{ep:02d}" for ep in episode])
            else:
                episode_key = f"e{episode:02d}"
            key = f"s{season:02d}{episode_key}"
            if key not in subtitle_metadata:
                subtitle_metadata[key] = []
            subtitle_metadata[key].append(srt)

    # Rename Hebrew subtitle to match video name exactly (no suffix)
    for video in video_files:
        video_metadata = guessit(video)
        season = video_metadata.get('season')
        episode = video_metadata.get('episode')
        media_type = video_metadata.get('type')
        title = video_metadata.get('title')
        video_base = os.path.splitext(video)[0]  # video path without extension
        target_srt = video_base + ".srt"

        if media_type == "episode":
            if isinstance(episode, list):
                episode_key = "-".join([f"e{ep:02d}" for ep in episode])
            else:
                episode_key = f"e{episode:02d}"
            key = f"s{season:02d}{episode_key}"

            if key in subtitle_metadata:
                srt = subtitle_metadata[key][0]
                if srt != target_srt:
                    os.rename(srt, target_srt)
                    print(f"Renamed subtitle '{srt}' to '{target_srt}'")
                else:
                    print(f"Subtitle already correctly named: '{srt}'")
            else:
                print(f"No Hebrew subtitle found for {key}")

        elif media_type == "movie":
            matched_srt = next(
                (srt for srt in subtitle_files if is_hebrew_sub(srt) and guessit(srt).get('title') == title),
                None
            )
            if matched_srt:
                if matched_srt != target_srt:
                    os.rename(matched_srt, target_srt)
                    print(f"Renamed subtitle '{matched_srt}' to '{target_srt}'")
                else:
                    print(f"Subtitle already correctly named: '{matched_srt}'")
            else:
                print(f"No Hebrew subtitle found for movie '{title}'")


if __name__ == "__main__":
    if len(sys.argv) > 1:
        match_videos_to_subtitles(sys.argv[1])
        print("Processing completed.")
    else:
        print("Please provide the path to the folder containing the videos and subtitles.")
