def strip_niqqud(s):
    return ''.join(ch for ch in s if unicodedata.category(ch) != 'Mn')


HEB_RE = re.compile(r'[֐-׿]')


def hebrew_only(s):
    """Strip any English commentary a model wrapped around its translation.

    Some CLI backends answer conversationally ("this is Tagalog, not English...")
    even when told not to. Keeping only the Hebrew also fixes the display:
    maybe_bidi_fix() decides by the FIRST strong character, so a leading English
    sentence makes it reverse the Hebrew that follows.
    """
    lines = [l for l in s.splitlines() if HEB_RE.search(l)]
    if not lines:
        return s.strip()
    out = []
    for l in lines:
        l = re.sub(r'[A-Za-z]+', '', l)            # drop Latin words
        l = re.sub(r'[ \t]{2,}', ' ', l)           # collapse the gaps they leave
        l = l.strip(' \t-–—:;,."\'()[]')
        if l:
            out.append(l)
    return ' '.join(out).strip() or s.strip()


def maybe_bidi_fix(s):
    s = strip_niqqud(s)
    for ch in s:
        b = unicodedata.bidirectional(ch)
        if b in ("R","AL","RLE","RLO"):
            return s
        if b in ("L","LRE","LRO"):
            break
    return get_display(s)


