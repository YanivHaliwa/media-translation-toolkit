# ---------------------------------------------------------------- language ---
# Auto-identify the language of the input, so the real language is passed to
# 'say', translate-shell, deep-translator and GoogleTranslator instead of a
# hardcoded 'en'. Codes use the legacy Google form ('iw' for Hebrew), which is
# what all four of those tools expect.
LANG_NAMES = {
    "en": "English",
    "tl": "Filipino",
    "ar": "Arabic",
    "ru": "Russian",
    "es": "Spanish",
    "fr": "French",
    "de": "German",
    "it": "Italian",
    "pt": "Portuguese",
}
LANG_CODES = tuple(LANG_NAMES)

# Unicode blocks that identify a language by script alone (always exact).
SCRIPT_RANGES = [
    ("ar", "؀", "ۿ"),   # Arabic
    ("ru", "Ѐ", "ӿ"),   # Cyrillic
]


def detect_lang(text):
    """Identify the language of the input text.

    Script detection first: exact, cannot be fooled.
    Statistical detection only for 3+ words, because n-gram detectors are
    unreliable on a single word ('caveat' is detected as Romanian).
    Anything shorter or unrecognised falls back to English.
    """
    for ch in text:
        for code, low, high in SCRIPT_RANGES:
            if low <= ch <= high:
                return code

    if len(text.split()) >= 3:
        try:
            from langdetect import detect, DetectorFactory
            DetectorFactory.seed = 0  # make detection deterministic
            code = detect(text)
            if code in LANG_CODES:
                return code
        except Exception:
            pass
    return "en"


